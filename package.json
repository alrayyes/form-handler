{
  "name": "form-handler-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so the Markdown tools are pinned like everything else.",
  "scripts": {
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:api": "redocly lint",
    "lint:json": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:package-json": "sort-package-json --check package.json",
    "lint:prose": "./scripts/lint-prose.sh",
    "prepare": "lefthook install"
  },
  "overrides": {
    "fast-uri": "4.2.2",
    "js-yaml": "5.4.1",
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@redocly/cli": "2.71.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
