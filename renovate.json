{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "description": "svu, which the release job installs rather than pulling as an image because the published image lags the releases.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github-ci\\.yml$/"],
      "matchStrings": ["go install (?<depName>[^\\s@]+)@(?<currentValue>v[\\w.-]+)"],
      "datasourceTemplate": "go"
    },
    {
      "description": "The mail server the integration test starts. It lives in a Go constant, where the docker manager would never think to look.",
      "customType": "regex",
      "managerFilePatterns": ["/_test\\.go$/"],
      "matchStrings": [
        "\"(?<depName>[^\"\\s:]+):(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
